# Ключ Claude API (https://console.anthropic.com). Без ключа приложение работает
# в офлайн-режиме: локальный движок подбора образов, без фото-оценки и веб-поиска.
ANTHROPIC_API_KEY=

# Модели (по умолчанию claude-opus-5). STYLIST_FAST_MODEL — для разметки вещей по фото.
STYLIST_MODEL=claude-opus-5
STYLIST_FAST_MODEL=claude-opus-5

PORT=8787
